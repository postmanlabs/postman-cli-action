{
  "info": {
    "_postman_id": "postman-echo-collection",
    "name": "Postman Echo Collection",
    "description": "A sample collection using Postman Echo API for testing the Postman CLI Action",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Request",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/get?foo={{testParam}}&bar=baz",
          "host": ["{{baseUrl}}"],
          "path": ["get"],
          "query": [
            {
              "key": "foo",
              "value": "{{testParam}}"
            },
            {
              "key": "bar",
              "value": "baz"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Query parameters are echoed back', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.args.foo).to.eql(pm.environment.get('testParam'));",
              "    pm.expect(response.args.bar).to.eql('baz');",
              "});",
              "",
              "pm.test('Response time is acceptable', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{userName}}\",\n  \"environment\": \"{{environmentName}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": ["{{baseUrl}}"],
          "path": ["post"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Request body is echoed back', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.data.name).to.eql(pm.environment.get('userName'));",
              "    pm.expect(response.data.environment).to.eql(pm.environment.get('environmentName'));",
              "});",
              "",
              "pm.test('Content-Type header is correct', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.headers['content-type']).to.include('application/json');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "PUT Request",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"name\": \"{{userName}}\",\n  \"updated\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/put",
          "host": ["{{baseUrl}}"],
          "path": ["put"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Request body is echoed back', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.data.id).to.eql(1);",
              "    pm.expect(response.data.updated).to.eql(true);",
              "});",
              "",
              "pm.test('Request method is PUT', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.url).to.include('/put');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "DELETE Request",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/delete?id=1",
          "host": ["{{baseUrl}}"],
          "path": ["delete"],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Query parameters are echoed back', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.args.id).to.eql('1');",
              "});",
              "",
              "pm.test('Request method is DELETE', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.url).to.include('/delete');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://postman-echo.com",
      "type": "string"
    }
  ]
}
